# Images
AGUSTA_BACKEND_IMAGE=ghcr.io/adaptx/agusta/agusta-backend:0.5.2
AGUSTA_FRONTEND_IMAGE=ghcr.io/adaptx/agusta/agusta-frontend:0.5.2

# AGUSTA HTTPS entrypoint. Nginx binds to all host interfaces by default.
AGUSTA_BIND=0.0.0.0
AGUSTA_HTTPS_PORT=443
# Hostname used only when generating the fallback self-signed certificate.
AGUSTA_PUBLIC_HOSTNAME=localhost
# Extra SAN entries for the generated self-signed certificate, for example:
# AGUSTA_CERT_EXTRA_SAN=DNS:agusta.example.com,IP:10.0.0.10
AGUSTA_CERT_EXTRA_SAN=
# Nginx request body limit.
AGUSTA_MAX_UPLOAD_SIZE=20m

# Django Web API process.
# Gunicorn worker processes and threads per worker.
AGUSTA_WEB_WORKERS=3
AGUSTA_WEB_THREADS=4
# Request timeout in seconds. Nginx derives its proxy timeout from this value.
AGUSTA_WEB_TIMEOUT=210
# HTTP keep-alive duration in seconds.
AGUSTA_WEB_KEEPALIVE=5
# Recycle workers after this many requests, with a random jitter.
AGUSTA_WEB_MAX_REQUESTS=1000
AGUSTA_WEB_MAX_REQUESTS_JITTER=100
# Maximum seconds doctor.sh waits for services to become ready.
AGUSTA_DOCTOR_WAIT_SECONDS=180

# Demonstration environment.
# Seeds an interconnected sample SOC (cases, alerts, artifacts, enrichments,
# knowledge, playbook history) so a fresh deployment is explorable immediately.
#   auto - seed only when the deployment has no cases (default, safe on upgrade)
#   on   - always ensure the demonstration data is present
#   off  - never seed; start empty
AGUSTA_DEMO_DATA=auto
# Also replay the bundled sample payloads through the real detection Modules, so
# some cases are produced by AGUSTA's own ingestion pipeline rather than seeded.
AGUSTA_DEMO_REPLAY=off

# HTTP management UIs.
# Bind and host ports for Redis Stack UI and RustFS Console.
AGUSTA_MANAGEMENT_BIND=0.0.0.0
AGUSTA_REDIS_UI_PORT=8001
AGUSTA_RUSTFS_CONSOLE_PORT=9001

# Django application settings.
DJANGO_SECRET_KEY=change-me-to-a-random-32-byte-minimum-secret
DJANGO_DEBUG=false
# Comma-separated hostnames accepted by Django.
DJANGO_ALLOWED_HOSTS=*
# Application log level, Django framework log level, and output format.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_LEVEL_DJANGO=INFO
DJANGO_LOG_FORMAT=text

# PostgreSQL.
POSTGRES_DB=agusta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Persistent connection lifetime in seconds and pre-use health checks.
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONN_HEALTH_CHECKS=true
# PostgreSQL server tuning. Memory values are per instance unless noted.
POSTGRES_MAX_CONNECTIONS=150
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
# Per-operation memory and maintenance-operation memory.
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
# Checkpoint spread ratio, planner disk cost, and slow-query threshold in ms.
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000

# Redis.
REDIS_HOST=redis-stack
REDIS_PORT=6379
# Redis logical database used by AGUSTA.
REDIS_DB=1
REDIS_PASSWORD=change-me-redis-password

# RustFS / S3-compatible object storage.
RUSTFS_ENDPOINT_URL=http://rustfs:9000
# S3-compatible credentials, bucket, and signing region.
RUSTFS_ACCESS_KEY=agusta
RUSTFS_SECRET_KEY=change-me-rustfs-password
RUSTFS_BUCKET=agusta
RUSTFS_REGION=us-east-1
